<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://example.test/httpbinding"
  targetNamespace="http://example.test/httpbinding"
  name="Catalog">
  <wsdl:message name="GetItemIn">
    <wsdl:part name="id" type="xs:string"/>
  </wsdl:message>
  <wsdl:message name="GetItemOut">
    <wsdl:part name="item" type="xs:string"/>
  </wsdl:message>
  <wsdl:portType name="CatalogPortType">
    <wsdl:operation name="GetItem">
      <wsdl:input message="tns:GetItemIn"/>
      <wsdl:output message="tns:GetItemOut"/>
    </wsdl:operation>
  </wsdl:portType>
  <!-- HTTP GET binding: skipped with a warning; the SOAP binding below stays usable. -->
  <wsdl:binding name="CatalogHttpGet" type="tns:CatalogPortType">
    <http:binding verb="GET"/>
    <wsdl:operation name="GetItem">
      <http:operation location="/items"/>
      <wsdl:input>
        <http:urlEncoded/>
      </wsdl:input>
      <wsdl:output>
        <http:urlEncoded/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="CatalogSoap" type="tns:CatalogPortType">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetItem">
      <soap:operation soapAction="http://example.test/httpbinding/GetItem" style="document"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="Catalog">
    <wsdl:port name="CatalogHttpPort" binding="tns:CatalogHttpGet">
      <http:address location="http://example.test/catalog"/>
    </wsdl:port>
    <wsdl:port name="CatalogSoapPort" binding="tns:CatalogSoap">
      <soap:address location="http://example.test/catalog.asmx"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
