<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://example.test/encoded"
  targetNamespace="http://example.test/encoded"
  name="LegacyEcho">
  <wsdl:message name="EchoRequest">
    <wsdl:part name="message" type="xs:string"/>
  </wsdl:message>
  <wsdl:message name="EchoResponse">
    <wsdl:part name="return" type="xs:string"/>
  </wsdl:message>
  <wsdl:portType name="LegacyEchoPortType">
    <wsdl:operation name="echo">
      <wsdl:input message="tns:EchoRequest"/>
      <wsdl:output message="tns:EchoResponse"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="LegacyEchoBinding" type="tns:LegacyEchoPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="echo">
      <soap:operation soapAction="echo" style="rpc"/>
      <wsdl:input>
        <soap:body use="encoded" namespace="http://example.test/encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="encoded" namespace="http://example.test/encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="LegacyEcho">
    <wsdl:port name="LegacyEchoPort" binding="tns:LegacyEchoBinding">
      <soap:address location="http://example.test/legacy"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
