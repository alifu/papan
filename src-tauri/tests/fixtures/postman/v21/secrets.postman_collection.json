{
  "info": {
    "_postman_id": "6f1c2a10-0000-4000-8000-000000000006",
    "name": "Secrets v2.1",
    "description": "Fake values only. Used to check that secrets are blanked on export and lifted on import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.test" },
    { "key": "apiSecret", "value": "" },
    { "key": "password", "value": "FAKE-PASSWORD-DO-NOT-USE", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "FAKE-TOKEN-DO-NOT-USE", "type": "string" }]
  },
  "item": [
    {
      "name": "Literal basic credentials",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/secret",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "fixture-user", "type": "string" },
            { "key": "password", "value": "FAKE-BASIC-DO-NOT-USE", "type": "string" }
          ]
        },
        "header": [{ "key": "X-Api-Key", "value": "{{apiSecret}}" }]
      }
    }
  ]
}
