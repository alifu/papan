{
  "info": {
    "_postman_id": "6f1c2a10-0000-4000-8000-000000000003",
    "name": "Auth v2.1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Folder apikey",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-Api-Key", "type": "string" },
          { "key": "value", "value": "{{apiKey}}", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Basic",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/basic",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{user}}", "type": "string" },
                { "key": "password", "value": "{{pass}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "AWS SigV4",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/aws",
            "auth": {
              "type": "awsv4",
              "awsv4": [
                { "key": "accessKey", "value": "{{awsAccessKey}}", "type": "string" },
                { "key": "secretKey", "value": "{{awsSecretKey}}", "type": "string" },
                { "key": "region", "value": "eu-west-1", "type": "string" },
                { "key": "service", "value": "execute-api", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Digest",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/digest",
            "auth": {
              "type": "digest",
              "digest": [
                { "key": "username", "value": "{{user}}", "type": "string" },
                { "key": "password", "value": "{{pass}}", "type": "string" },
                { "key": "algorithm", "value": "MD5", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "EdgeGrid",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/edge",
            "auth": {
              "type": "edgegrid",
              "edgegrid": [
                { "key": "accessToken", "value": "{{edgeAccessToken}}", "type": "string" },
                { "key": "clientToken", "value": "{{edgeClientToken}}", "type": "string" },
                { "key": "clientSecret", "value": "{{edgeClientSecret}}", "type": "string" },
                { "key": "baseURI", "value": "https://akab.example.test", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Hawk",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/hawk",
            "auth": {
              "type": "hawk",
              "hawk": [
                { "key": "authId", "value": "{{hawkId}}", "type": "string" },
                { "key": "authKey", "value": "{{hawkKey}}", "type": "string" },
                { "key": "algorithm", "value": "sha256", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "NTLM",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ntlm",
            "auth": {
              "type": "ntlm",
              "ntlm": [
                { "key": "username", "value": "{{user}}", "type": "string" },
                { "key": "password", "value": "{{pass}}", "type": "string" },
                { "key": "domain", "value": "EXAMPLE", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "OAuth1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth1",
            "auth": {
              "type": "oauth1",
              "oauth1": [
                { "key": "consumerKey", "value": "{{consumerKey}}", "type": "string" },
                { "key": "consumerSecret", "value": "{{consumerSecret}}", "type": "string" },
                { "key": "signatureMethod", "value": "HMAC-SHA1", "type": "string" },
                { "key": "addParamsToHeader", "value": true, "type": "boolean" }
              ]
            }
          }
        },
        {
          "name": "OAuth2",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth2",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                { "key": "accessToken", "value": "{{accessToken}}", "type": "string" },
                { "key": "tokenType", "value": "Bearer", "type": "string" },
                { "key": "addTokenTo", "value": "header", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "No auth",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/public",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Bearer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bearer",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            }
          }
        }
      ]
    }
  ]
}
