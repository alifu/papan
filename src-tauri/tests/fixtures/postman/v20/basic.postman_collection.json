{
  "info": {
    "_postman_id": "9a7b3c20-0000-4000-8000-000000000001",
    "name": "Basic v2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "item": [
    {
      "name": "Folder",
      "item": [
        {
          "name": "Get item",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["items", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Post urlencoded",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/form",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "name", "value": "Ada", "enabled": true }]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Root raw",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/raw",
        "body": { "mode": "raw", "raw": "{\"a\": 1}" }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": { "id": "1", "type": "text/javascript", "exec": ["pm.environment.set('v20', 'yes');"] }
    }
  ],
  "variable": [{ "id": "base", "key": "baseUrl", "value": "https://api.example.test", "type": "string" }]
}
